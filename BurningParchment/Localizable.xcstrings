    "자유시간은 페이지 표시에서 모래시계로 보여요. 데드라인은 추가하면 저절로 나타나요" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volný čas se mezi tečkami stránek zobrazí jako přesýpací hodiny. Termíny se objeví samy, jakmile je přidáte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fritid vises som et timeglas i sideprikkerne. Frister dukker op af sig selv, når du tilføjer dem"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freizeit erscheint in den Seitenpunkten als Sanduhr. Deadlines erscheinen von selbst, sobald du sie hinzufügst"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ελεύθερος χρόνος εμφανίζεται ως κλεψύδρα στις τελείες σελίδων. Οι προθεσμίες εμφανίζονται μόνες τους μόλις τις προσθέσετε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free Time shows as an hourglass in the page dots. Deadlines appear on their own once added"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free Time shows as an hourglass in the page dots. Deadlines appear on their own once added"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo libre aparece como un reloj de arena en los puntos de página. Las fechas límite aparecen solas al añadirlas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapaa-aika näkyy tiimalasina sivupisteissä. Määräajat ilmestyvät itsestään, kun lisäät niitä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps libre apparaît sous forme de sablier dans les points de pages. Les échéances apparaissent d’elles-mêmes dès que vous en ajoutez"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu luang tampil sebagai jam pasir di titik halaman. Tenggat muncul sendiri setelah kamu menambahkannya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo libero appare come clessidra nei puntini delle pagine. Le scadenze compaiono da sole quando le aggiungi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由時間はページ表示で砂時計として表示されます。締め切りは追加すると自動で表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자유시간은 페이지 표시에서 모래시계로 보여요. 데드라인은 추가하면 저절로 나타나요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fritid vises som et timeglass i sideprikkene. Frister dukker opp av seg selv når du legger dem til"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrije tijd verschijnt als zandloper in de paginapunten. Deadlines verschijnen vanzelf zodra je ze toevoegt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolny czas pojawia się jako klepsydra wśród kropek stron. Terminy pojawiają się same po dodaniu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo livre aparece como uma ampulheta nos pontos de página. Os prazos aparecem sozinhos quando você os adiciona"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свободное время отображается песочными часами среди точек страниц. Дедлайны появляются сами, как только вы их добавите"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fritid visas som ett timglas bland sidprickarna. Deadlines dyker upp av sig själva när du lägger till dem"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาว่างแสดงเป็นนาฬิกาทรายในจุดบอกหน้า กำหนดส่งจะปรากฏเองเมื่อเพิ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş zaman, sayfa noktalarında kum saati olarak görünür. Son tarihler ekledikçe kendiliğinden belirir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian rảnh hiện thành đồng hồ cát trong chấm trang. Hạn chót tự hiện khi bạn thêm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由时间在页面指示点中显示为沙漏。添加截止日期后会自动出现"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由時間在頁面指示點中顯示為沙漏。新增截止日期後會自動出現"
          }
        }
      }
    },
    "자유시간이 지나갈 때만 불이 붙고, 밖에서는 꺼진 채 기다려요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozsvítí se, dokud váš volný čas plyne, a zbytek týdne čeká zhasnutý"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tændes, mens din fritid går, og venter slukket resten af ugen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es brennt, solange deine Freizeit läuft, und wartet in der übrigen Woche unentzündet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανάβει όσο περνά ο ελεύθερος χρόνος σας και περιμένει σβηστή τον υπόλοιπο χρόνο της εβδομάδας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lights up while your free time passes and waits unlit the rest of the week"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lights up while your free time passes and waits unlit the rest of the week"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se enciende mientras pasa tu tiempo libre y el resto de la semana espera apagado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se syttyy, kun vapaa-aikasi kuluu, ja odottaa sammuneena loppuviikon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’allume tant que votre temps libre s’écoule et attend éteint le reste de la semaine"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyala saat waktu luangmu berlalu dan menunggu dalam keadaan padam di sisa minggu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si accende mentre passa il tuo tempo libero e resta spento nel resto della settimana"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由時間が過ぎるときだけ火がつき、それ以外は消えたまま待っています"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tennes mens fritiden din går, og venter slukket resten av uken"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gaat branden zolang je vrije tijd verstrijkt en wacht de rest van de week gedoofd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapala się, gdy Twój wolny czas upływa, i czeka zgaszony przez resztę tygodnia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acende enquanto seu tempo livre passa e espera apagado no resto da semana"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Огонь зажигается, пока идёт ваше свободное время, а в остальные часы недели ждёт погасшим"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tänds medan din fritid går och väntar släckt resten av veckan"
          }
        },
        "th" : {
