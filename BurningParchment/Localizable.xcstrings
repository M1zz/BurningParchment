    "오늘 한 일을 한 줄로 남기면 그 주의 재 항아리에 쌓여요. 기상과 취침 시간은 설정에서 바꿀 수 있어요." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日したことをひとこと残すと、その週の灰の壺に積もっていきます。起床と就寝の時間は設定で変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 한 일을 한 줄로 남기면 그 주의 재 항아리에 쌓여요. 기상과 취침 시간은 설정에서 바꿀 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write one line about your day and it settles into that week's ash urn. Change your wake and bedtimes in Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write one line about your day and it settles into that week's ash urn. Change your wake and bedtimes in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe una línea sobre tu día y se asentará en la urna de ceniza de esa semana. Cambia tus horas de despertar y de dormir en Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib eine Zeile über deinen Tag, und sie sammelt sich in der Ascheurne dieser Woche. Aufsteh- und Schlafenszeit änderst du in den Einstellungen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一句话记下今天做的事，它就会落进当周的灰罐。起床和就寝时间可在设置中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一句話記下今天做的事，它就會落進當週的灰罐。起床和就寢時間可在設定中更改。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите о дне одну строку — и она осядет в урне пепла этой недели. Время подъёма и сна меняется в настройках."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez une ligne sur votre journée et elle se dépose dans l’urne de cendres de la semaine. Changez vos heures de réveil et de coucher dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi una riga sulla tua giornata e si deposita nell’urna di cenere di quella settimana. Cambia gli orari di sveglia e riposo nelle Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva uma linha sobre o seu dia e ela assenta na urna de cinzas daquela semana. Mude os horários de acordar e dormir nos Ajustes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนวันของคุณหนึ่งบรรทัด แล้วมันจะตกลงในโถเถ้าของสัปดาห์นั้น เปลี่ยนเวลาตื่นและเวลานอนได้ในการตั้งค่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viết một dòng về ngày của bạn và nó sẽ lắng vào bình tro của tuần đó. Đổi giờ thức và giờ ngủ trong Cài đặt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napište o svém dni jeden řádek a usadí se v urně s popelem toho týdne. Čas vstávání a spaní změníte v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en linje om din dag, så lægger den sig i ugens askeurne. Skift tidspunkt for opvågning og sengetid i Indstillinger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε μία γραμμή για τη μέρα σας και θα κατακαθίσει στο τεφροδοχείο στάχτης εκείνης της εβδομάδας. Αλλάξτε τις ώρες ξυπνήματος και ύπνου στις Ρυθμίσεις."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita päivästäsi yksi rivi, ja se laskeutuu kyseisen viikon tuhkauurnaan. Vaihda herätys- ja nukkumaanmenoaikasi Asetuksissa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis satu baris tentang harimu dan ia mengendap di guci abu minggu itu. Ubah waktu bangun dan tidur di Pengaturan."
          }
        }
      },
      "comment" : "Onboarding page 3 detail"
    },
