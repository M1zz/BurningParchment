    "제시간에 불을 껐어요. 내일의 양피지는 그대로예요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oheň jste zhasili včas. Zítřejší pergamen zůstal nedotčený"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du slukkede ilden til tiden. I morgens pergament er urørt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast das Feuer rechtzeitig gelöscht. Das Pergament von morgen bleibt unberührt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σβήσατε τη φωτιά εγκαίρως. Η περγαμηνή του αύριο μένει άθικτη"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You put out the fire on time. Tomorrow's parchment is untouched"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You put out the fire on time. Tomorrow's parchment is untouched"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagaste el fuego a tiempo. El pergamino de mañana queda intacto"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammutit tulen ajoissa. Huomisen pergamentti on koskematon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez éteint le feu à l’heure. Le parchemin de demain est intact"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu memadamkan api tepat waktu. Perkamen besok tidak tersentuh"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai spento il fuoco in orario. La pergamena di domani è intatta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間どおりに火を消しました。明日の羊皮紙はそのままです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제시간에 불을 껐어요. 내일의 양피지는 그대로예요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du slukket ilden i tide. I morgens pergament er urørt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je doofde het vuur op tijd. Het perkament van morgen is onaangeroerd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgasiłeś/aś ogień na czas. Jutrzejszy pergamin jest nietknięty"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você apagou o fogo no horário. O pergaminho de amanhã está intacto"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы вовремя погасили огонь. Завтрашний пергамент не тронут"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du släckte elden i tid. Morgondagens pergament är orört"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณดับไฟตรงเวลา กระดาษหนังของพรุ่งนี้ยังอยู่เหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ateşi zamanında söndürdün. Yarının parşömeni olduğu gibi duruyor"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã tắt lửa đúng giờ. Giấy da ngày mai vẫn nguyên vẹn"
          }
        },
        "zh-Hans" : {
