    "내일 아침, 양피지 상단에 띠로 떠올라 하루와 함께 타들어가요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow morning it appears as a band atop the parchment and burns along with your day."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일 아침, 양피지 상단에 띠로 떠올라 하루와 함께 타들어가요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
