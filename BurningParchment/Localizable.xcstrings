          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queime em hanji ao luar, celadon ou entardecer, como fogo de campo, brasas ou estrelinha"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เผาด้วยฮันจิใต้แสงจันทร์ เซลาดอน หรือยามพลบค่ำ ในรูปไฟป่าทุ่ง ถ่านไฟ หรือประทัดดอกไม้ไฟ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đốt bằng giấy hanji dưới trăng, men ngọc hoặc hoàng hôn, theo kiểu lửa đồng, than hồng hay pháo bông cầm tay"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hořte v měsíčním hanji, celadonu nebo soumraku — jako stepní požár, uhlíky nebo prskavka"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brænd i måneskins-hanji, celadon eller solnedgang som prærieild, gløder eller stjernekaster"
