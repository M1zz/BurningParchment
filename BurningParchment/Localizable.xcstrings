        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’urne vous attend déjà.\\nVotre première cendre ira dans « %@ »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guci sudah menunggu.\\nAbu pertamamu masuk ke guci %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
