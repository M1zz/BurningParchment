        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gününle ilgili bir satır yaz, o haftanın kül kavanozuna çöksün. Uyanma ve uyuma saatlerini Ayarlar’dan değiştir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viết một dòng về ngày của bạn và nó sẽ lắng vào bình tro của tuần đó. Đổi giờ thức và giờ ngủ trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
