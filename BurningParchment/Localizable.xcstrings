    "· 좌표 없는 옛 회고 %@개는 사분면 안에 흩어 표시" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Starší ohlédnutí bez uloženého bodu (%@) jsou rozptýlena v rámci svého kvadrantu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ ældre refleksioner uden gemt punkt er spredt i deres kvadrant"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ ältere Rückblicke ohne gespeicherten Punkt sind im Quadranten verstreut"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ παλαιότεροι απολογισμοί χωρίς αποθηκευμένο σημείο είναι διάσπαρτοι στο τεταρτημόριό τους"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ older entries without saved points are scattered within their quadrant"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ older entries without saved points are scattered within their quadrant"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ reflexiones antiguas sin punto guardado se muestran dispersas dentro de su cuadrante"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ vanhempaa pohdintaa ilman tallennettua pistettä on hajautettu neljänneksensä sisään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ anciens bilans sans point enregistré sont dispersés dans leur quadrant"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ refleksi lama tanpa titik tersimpan disebar di dalam kuadrannya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ vecchie riflessioni senza punto salvato sono sparse nel loro quadrante"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· 座標のない古いふりかえり%@件は象限内に散らして表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· 좌표 없는 옛 회고 %@개는 사분면 안에 흩어 표시"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ eldre refleksjoner uten lagret punkt er spredt innenfor kvadranten sin"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ oudere reflecties zonder opgeslagen punt zijn verspreid binnen hun kwadrant"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Starsze refleksje bez zapisanego punktu (%@) są rozrzucone w obrębie swojej ćwiartki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ reflexões antigas sem ponto salvo estão espalhadas dentro do quadrante"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Старые записи без сохранённой точки (%@) разбросаны по своему квадранту"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ äldre reflektioner utan sparad punkt är utspridda inom sin kvadrant"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· บันทึกทบทวนเก่า %@ รายการที่ไม่มีจุดที่บันทึกไว้ จะกระจายอยู่ในช่องของมัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· Kayıtlı noktası olmayan %@ eski değerlendirme, çeyreği içinde dağınık gösterilir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· %@ bản nhìn lại cũ chưa lưu điểm được rải trong góc phần tư của chúng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· 没有坐标的旧回顾 %@ 条，散布显示在象限内"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· 沒有座標的舊回顧 %@ 條，散佈顯示在象限內"
          }
        }
      }
    },
