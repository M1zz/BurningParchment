    "마이크에 대고 후 불면 불이 꺼지고 남은 조각을 모아 둬요. 입김의 세기만 확인하고 소리는 녹음하지 않아요." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクに向かって吹くと火が消え、残ったかけらをしまっておけます。息の強さを確かめるだけで、音は録音しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크에 대고 후 불면 불이 꺼지고 남은 조각을 모아 둬요. 입김의 세기만 확인하고 소리는 녹음하지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blow into the microphone to put out the fire and keep what's left. Only the strength of your breath is checked; nothing is recorded."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blow into the microphone to put out the fire and keep what's left. Only the strength of your breath is checked; nothing is recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopla en el micrófono para apagar el fuego y guardar lo que queda. Solo se mide la intensidad de tu soplido; no se graba nada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puste ins Mikrofon, um das Feuer zu löschen und den Rest aufzubewahren. Nur die Stärke deines Atems wird geprüft, es wird nichts aufgenommen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对着麦克风吹一口气，火就熄灭，剩下的碎片会被收起。只检测吹气的力度，不会录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對著麥克風吹一口氣，火就熄滅，剩下的碎片會被收起。只檢測吹氣的力度，不會錄音。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подуйте в микрофон, чтобы погасить огонь и сохранить остаток. Проверяется только сила дыхания, звук не записывается."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soufflez dans le micro pour éteindre le feu et garder ce qu’il reste. Seule la force de votre souffle est vérifiée ; rien n’est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soffia nel microfono per spegnere il fuoco e conservare ciò che resta. Viene controllata solo la forza del soffio; non viene registrato nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopre no microfone para apagar o fogo e guardar o que sobrou. Só a força do sopro é verificada; nada é gravado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป่าใส่ไมโครโฟนเพื่อดับไฟและเก็บส่วนที่เหลือไว้ ตรวจเฉพาะแรงลมเป่า ไม่มีการบันทึกเสียง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thổi vào micro để tắt lửa và giữ lại phần còn lại. Chỉ kiểm tra sức thổi, không ghi âm gì."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foukněte do mikrofonu, uhaste oheň a uschovejte zbytek. Kontroluje se jen síla dechu, nic se nenahrává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pust ind i mikrofonen for at slukke ilden og gemme det, der er tilbage. Kun styrken af dit åndedræt tjekkes; intet optages."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φυσήξτε στο μικρόφωνο για να σβήσει η φωτιά και να κρατήσετε ό,τι απομένει. Ελέγχεται μόνο η ένταση της πνοής· δεν καταγράφεται τίποτα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhalla mikrofoniin sammuttaaksesi tulen ja säästääksesi jäljelle jääneen. Vain hengityksesi voimakkuus tarkistetaan; mitään ei tallenneta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiup mikrofon untuk memadamkan api dan menyimpan yang tersisa. Hanya kekuatan napasmu yang diperiksa; tidak ada yang direkam."
          }
        }
      },
      "comment" : "Onboarding page 2 detail"
    },
    "하루는 재로 남아요" : {
      "localizations" : {
