    "잠들기 전을 고르면 취침 1시간 전부터 잠금화면과 다이나믹 아일랜드에 남은 시간이 보여요. 다이나믹 아일랜드를 누르면 앱이 열려요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S volbou „Před spaním“ se zbývající čas zobrazí na zamčené obrazovce a v Dynamic Island hodinu před spaním. Klepnutím na Dynamic Island se otevře aplikace"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med „Før sengetid“ vises den resterende tid på låseskærmen og i Dynamic Island fra en time før sengetid. Et tryk på Dynamic Island åbner appen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Vor dem Schlafen“ erscheint die restliche Zeit ab einer Stunde vor der Schlafenszeit auf dem Sperrbildschirm und in der Dynamic Island. Tippen auf die Dynamic Island öffnet die App"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με την επιλογή «Πριν τον ύπνο», ο χρόνος που απομένει εμφανίζεται στην οθόνη κλειδώματος και στο Dynamic Island από μία ώρα πριν τον ύπνο. Αν πατήσετε το Dynamic Island, ανοίγει η εφαρμογή"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Before Bed, the time left appears on the Lock Screen and in the Dynamic Island from one hour before bedtime. Tapping the Dynamic Island opens the app"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Before Bed, the time left appears on the Lock Screen and in the Dynamic Island from one hour before bedtime. Tapping the Dynamic Island opens the app"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Antes de dormir», el tiempo restante aparece en la pantalla de bloqueo y en la Dynamic Island desde una hora antes de dormir. Al tocar la Dynamic Island se abre la app"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun valitset ”Ennen nukkumaan”, jäljellä oleva aika näkyy lukitusnäytöllä ja Dynamic Islandissa tuntia ennen nukkumaanmenoa. Dynamic Islandin napauttaminen avaa apin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec « Avant le coucher », le temps restant s’affiche sur l’écran verrouillé et dans la Dynamic Island une heure avant le coucher. Toucher la Dynamic Island ouvre l’app"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan “Sebelum tidur”, sisa waktu muncul di Layar Terkunci dan Dynamic Island mulai satu jam sebelum waktu tidur. Mengetuk Dynamic Island akan membuka app"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Prima di dormire», il tempo rimasto appare nella schermata di blocco e nella Dynamic Island da un’ora prima di dormire. Toccando la Dynamic Island si apre l’app"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「寝る前」を選ぶと、就寝の1時間前からロック画面とダイナミックアイランドに残り時間が表示されます。ダイナミックアイランドをタップするとアプリが開きます"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med «Før leggetid» vises tiden som er igjen på låseskjermen og i Dynamic Island fra én time før leggetid. Et trykk på Dynamic Island åpner appen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met ‘Voor bedtijd’ zie je de resterende tijd vanaf een uur voor bedtijd op het toegangsscherm en in het Dynamic Island. Tikken op het Dynamic Island opent de app"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy opcji „Przed snem” pozostały czas pojawia się na ekranie blokady i w Dynamic Island na godzinę przed snem. Stuknięcie Dynamic Island otwiera aplikację"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com “Antes de dormir”, o tempo restante aparece na Tela Bloqueada e na Ilha Dinâmica a partir de uma hora antes de dormir. Tocar na Ilha Dinâmica abre o app"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме «Перед сном» оставшееся время появляется на экране блокировки и в Dynamic Island за час до сна. Нажатие на Dynamic Island открывает приложение"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ”Före läggdags” visas återstående tid på låsskärmen och i Dynamic Island från en timme före läggdags. Om du trycker på Dynamic Island öppnas appen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเลือก “ก่อนนอน” เวลาที่เหลือจะแสดงบนหน้าจอล็อกและ Dynamic Island ตั้งแต่ 1 ชั่วโมงก่อนเวลานอน การแตะ Dynamic Island จะเปิดแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uyumadan önce” seçiliyse kalan süre, uyku saatinden bir saat önce kilit ekranında ve Dynamic Island’da görünür. Dynamic Island’a dokunmak uygulamayı açar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chọn “Trước khi ngủ”, thời gian còn lại hiện trên Màn hình khóa và Dynamic Island từ một giờ trước giờ ngủ. Chạm vào Dynamic Island sẽ mở ứng dụng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“睡前”后，就寝前 1 小时起，锁定屏幕和灵动岛会显示剩余时间。轻点灵动岛会打开 App"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「睡前」後，就寢前 1 小時起，鎖定畫面和動態島會顯示剩餘時間。點一下動態島會打開 App"
          }
        }
      }
    },
