          "stringUnit" : {
            "state" : "translated",
            "value" : "Ateşi söndürmek de cesaret ister"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dập lửa cũng cần dũng cảm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熄灭火焰也是一种勇气"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熄滅火焰也是一種勇氣"
          }
        }
      }
    },
    "불을 끄지 못했어도, 제시간에 잠들었으니 불은 저절로 꺼졌어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesfoukli jste ho, ale usnuli jste včas, takže oheň zhasl sám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du pustede ikke ud, men faldt i søvn til tiden, så ilden gik ud af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast nicht gepustet, aber du bist pünktlich eingeschlafen, also ist das Feuer von selbst ausgegangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν φυσήξατε, αλλά κοιμηθήκατε εγκαίρως, οπότε η φωτιά έσβησε μόνη της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You didn't blow it out, but you fell asleep on time, so the fire went out on its own."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You didn't blow it out, but you fell asleep on time, so the fire went out on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No soplaste, pero te dormiste a tu hora y el fuego se apagó solo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et puhaltanut, mutta nukahdit ajoissa, joten tuli sammui itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas soufflé, mais vous vous êtes endormi(e) à l’heure : le feu s’est éteint tout seul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidak meniup, tetapi tidur tepat waktu, jadi api padam dengan sendirinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai soffiato, ma ti sei addormentato/a in orario, quindi il fuoco si è spento da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "火は消せませんでしたが、時間どおりに眠ったので、火は自然に消えました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불을 끄지 못했어도, 제시간에 잠들었으니 불은 저절로 꺼졌어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blåste ikke, men sovnet i tide, så ilden gikk ut av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je blies niet, maar viel op tijd in slaap, dus het vuur doofde vanzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zdmuchnąłeś/aś go, ale zasnąłeś/aś na czas, więc ogień zgasł sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não soprou, mas dormiu no horário, então o fogo se apagou sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не задули огонь, но уснули вовремя — и он погас сам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blåste inte, men somnade i tid, så elden slocknade av sig själv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่ได้เป่า แต่หลับตรงเวลา ไฟจึงดับไปเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üflemedin ama zamanında uyudun, bu yüzden ateş kendiliğinden söndü."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chưa thổi, nhưng đã ngủ đúng giờ nên lửa tự tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虽然没吹灭，但你按时睡着了，火自己熄灭了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雖然沒吹滅，但你按時睡著了，火自己熄滅了。"
          }
        }
      }
    },
