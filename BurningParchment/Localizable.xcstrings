    "내일 아침, 양피지 상단에 띠로 떠올라 하루와 함께 타들어가요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zítra ráno se objeví jako pruh nahoře na pergamenu a shoří spolu s vaším dnem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I morgen tidlig dukker det op som et bånd øverst på pergamentet og brænder sammen med din dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
