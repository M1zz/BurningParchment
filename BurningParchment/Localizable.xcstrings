    "잠들면 저절로 멈춰요. 잠든 시각은 아침에 확인해서 되돌려요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo se zastaví, jakmile usnete. Ráno zkontrolujeme, kdy jste usnuli, a vrátíme ho zpět"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det stopper af sig selv, når du sover. Om morgenen tjekker vi, hvornår du faldt i søvn, og sætter det tilbage"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es stoppt von selbst, sobald du schläfst. Am Morgen prüfen wir, wann du eingeschlafen bist, und setzen es zurück"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σταματά μόνη της μόλις κοιμηθείτε. Το πρωί ελέγχουμε πότε κοιμηθήκατε και την επαναφέρουμε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stops on its own once you're asleep. We check when you fell asleep in the morning and roll it back"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stops on its own once you're asleep. We check when you fell asleep in the morning and roll it back"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene solo cuando te duermes. Por la mañana comprobamos a qué hora te dormiste y lo devolvemos a ese momento"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pysähtyy itsestään, kun nukahdat. Aamulla tarkistamme, milloin nukahdit, ja palautamme sen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’arrête tout seul dès que vous dormez. Nous vérifions le matin à quelle heure vous vous êtes endormi(e) et le remettons en arrière"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhenti sendiri begitu kamu tertidur. Paginya kami memeriksa kapan kamu tertidur dan memutarnya kembali"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma da sola quando ti addormenti. La mattina controlliamo a che ora ti sei addormentato/a e la riportiamo indietro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眠ると自動で止まります。眠りについた時刻は朝に確認して巻き戻します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠들면 저절로 멈춰요. 잠든 시각은 아침에 확인해서 되돌려요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det stopper av seg selv når du sovner. Om morgenen sjekker vi når du sovnet, og setter det tilbake"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het stopt vanzelf zodra je slaapt. ’s Ochtends kijken we wanneer je in slaap viel en zetten we het terug"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymuje się sam, gdy zaśniesz. Rano sprawdzamy, kiedy zasnąłeś/aś, i cofamy go"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sozinho quando você dorme. De manhã conferimos a hora em que você adormeceu e voltamos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Огонь гаснет сам, когда вы засыпаете. Утром мы проверяем, когда вы уснули, и возвращаем его назад"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det stannar av sig självt när du sover. På morgonen kontrollerar vi när du somnade och sätter tillbaka det"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดเองเมื่อคุณหลับ เราจะตรวจสอบเวลาที่คุณหลับในตอนเช้าแล้วย้อนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyuyunca kendiliğinden durur. Sabah ne zaman uyuduğunu kontrol edip geri alırız"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự dừng khi bạn ngủ. Sáng ra chúng tôi kiểm tra bạn ngủ lúc nào rồi đưa về"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡着后会自动停下。早晨会确认入睡时间，并把火往回拨"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡著後會自動停下。早晨會確認入睡時間，並把火往回撥"
          }
        }
      }
    },
