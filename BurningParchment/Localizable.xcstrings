    "달빛 한지, 청자, 노을. 양피지와 불꽃의 빛깔을 바꿔요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlit Hanji, Celadon, Dusk. Change the color of the paper and the flame."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달빛 한지, 청자, 노을. 양피지와 불꽃의 빛깔을 바꿔요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月明かりの韓紙、青磁、夕焼け。羊皮紙と炎の色合いを変えられます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlit Hanji, Celadon, Dusk. Change the colour of the paper and the flame."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanji a la luz de la luna, Celadón y Atardecer. Cambia el color del papel y de la llama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondlicht-Hanji, Seladon, Abendrot. Ändere die Farbe von Papier und Flamme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月光韩纸、青瓷、晚霞。更换羊皮纸和火焰的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月光韓紙、青瓷、晚霞。更換羊皮紙和火焰的顏色。"
          }
        }
      }
    },
    "달빛 한지·청자·노을 빛깔, 들불·숯불·불티로 양피지가 타요" : {
