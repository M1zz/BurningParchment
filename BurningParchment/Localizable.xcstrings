    "잠·일·해야 할 일을 빼고, 온전히 나를 위해 쓰는 시간만 적어 주세요. 이 시간이 지나갈 때만 이번 주 양피지가 타요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechte spánek, práci a povinnosti a přidejte jen čas, který věnujete sobě. Pergamen tohoto týdne hoří jen po dobu jeho plynutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udelad søvn, arbejde og pligter, og tilføj kun den tid, du bruger på dig selv. Denne uges pergament brænder kun, mens den går."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Schlaf, Arbeit und Pflichten weg und trage nur die Zeit ein, die du für dich selbst nutzt. Das Pergament dieser Woche brennt nur, solange sie vergeht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε έξω τον ύπνο, τη δουλειά και τις υποχρεώσεις και προσθέστε μόνο τον χρόνο που περνάτε για τον εαυτό σας. Η περγαμηνή αυτής της εβδομάδας καίγεται μόνο όσο περνά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave out sleep, work and chores, and add only the time you spend on yourself. This week's parchment burns only while it passes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave out sleep, work and chores, and add only the time you spend on yourself. This week's parchment burns only while it passes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja fuera el sueño, el trabajo y las tareas, y añade solo el tiempo que dedicas a ti. El pergamino de esta semana arde solo mientras ese tiempo pasa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä pois uni, työ ja askareet ja lisää vain se aika, jonka käytät itseesi. Tämän viikon pergamentti palaa vain sen kuluessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écartez le sommeil, le travail et les corvées, et n’ajoutez que le temps que vous vous consacrez. Le parchemin de cette semaine ne brûle que pendant qu’il s’écoule."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecualikan tidur, kerja, dan urusan rumah, lalu tambahkan hanya waktu yang kamu pakai untuk dirimu sendiri. Perkamen minggu ini hanya terbakar selama waktu itu berlalu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escludi sonno, lavoro e faccende e aggiungi solo il tempo che dedichi a te. La pergamena di questa settimana brucia solo mentre passa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠・仕事・やるべきことを除いて、自分のためだけに使う時間を入力してください。この時間が過ぎるときだけ、今週の羊皮紙が燃えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La søvn, jobb og gjøremål ligge utenfor, og legg bare til tiden du bruker på deg selv. Pergamentet denne uken brenner bare mens den går."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat slaap, werk en klusjes weg en voeg alleen de tijd toe die je aan jezelf besteedt. Het perkament van deze week brandt alleen terwijl die tijd verstrijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiń sen, pracę i obowiązki i dodaj tylko czas, który poświęcasz sobie. Pergamin tego tygodnia pali się tylko wtedy, gdy ten czas upływa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe de fora sono, trabalho e tarefas e adicione só o tempo que você dedica a si mesmo. O pergaminho desta semana queima só enquanto ele passa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не включайте сон, работу и дела — добавьте только время, которое тратите на себя. Пергамент этой недели горит, только пока оно идёт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utelämna sömn, arbete och måsten och lägg bara till den tid du ägnar åt dig själv. Veckans pergament brinner bara medan den går."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เว้นการนอน งาน และธุระ แล้วเพิ่มเฉพาะเวลาที่คุณใช้กับตัวเอง กระดาษหนังของสัปดาห์นี้จะไหม้เฉพาะตอนที่เวลานั้นผ่านไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uykuyu, işi ve angaryayı bir kenara bırak; sadece kendine ayırdığın zamanı ekle. Bu haftanın parşömeni yalnızca o zaman geçerken yanar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ giấc ngủ, công việc và việc vặt, chỉ thêm thời gian bạn dành cho bản thân. Giấy da của tuần này chỉ cháy khi thời gian đó trôi qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请排除睡觉、工作和杂事，只填写完全为自己所用的时间。只有这段时间流逝时，本周的羊皮纸才会燃烧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請排除睡覺、工作和雜事，只填寫完全為自己所用的時間。只有這段時間流逝時，本週的羊皮紙才會燃燒。"
          }
        }
      }
    },
    "잠과 일을 뺀 진짜 내 시간을 골라 두면, 그 시간이 지나갈 때만 이번 주 양피지가 타요." : {
