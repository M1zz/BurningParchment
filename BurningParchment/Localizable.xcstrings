    "잘 타오른 하루, 이제 식힐 시간" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobře prohořelý den. Je čas nechat ho vychladnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En veltilbragt dag. Tid til at lade den køle af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag, der gut gebrannt hat. Zeit zum Abkühlen."
