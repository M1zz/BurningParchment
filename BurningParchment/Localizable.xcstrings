    "남은 조각은 모아 둘게요.\n오늘은 이대로 푹 자요" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbytek uschováme.\\nTeď se dobře vyspěte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi gemmer det, der er tilbage.\\nNu skal du sove godt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir heben auf, was übrig ist.\nJetzt schlaf gut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα κρατήσουμε ό,τι απέμεινε.\\nΤώρα κοιμηθείτε καλά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll keep what's left.\nNow get some good sleep."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll keep what's left.\nNow get a good night's sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardaremos lo que queda.\nAhora, a dormir bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytämme sen, mikä jäi jäljelle.\\nNuku nyt hyvin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous gardons ce qu’il reste.\\nMaintenant, dormez bien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisanya akan kami simpan.\\nSekarang tidurlah yang nyenyak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserviamo quello che resta.\\nOra dormi bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残ったかけらはしまっておきます。\n今夜はこのままゆっくり休んでください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남은 조각은 모아 둘게요.\n오늘은 이대로 푹 자요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
