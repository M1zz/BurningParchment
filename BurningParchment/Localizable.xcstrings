    "글자 크기를 아주 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: layouts for larger text",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani při největší velikosti textu se obrazovky neořezávají, ale úhledně přeskupí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med de største tekststørrelser omarrangeres skærmene pænt i stedet for at blive skåret af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei der größten Schriftgröße ordnen sich die Bildschirme sauber neu an, statt abgeschnitten zu werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη και στα μεγαλύτερα μεγέθη κειμένου, οι οθόνες αναδιατάσσονται σωστά αντί να κόβονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly instead of getting cut off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly instead of getting cut off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso con los tamaños de texto más grandes, las pantallas se reorganizan con orden en lugar de quedar cortadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurimmillakaan tekstikooilla näytöt eivät leikkaudu, vaan järjestyvät siististi uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même avec les plus grandes tailles de texte, les écrans se réorganisent proprement au lieu d’être coupés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahkan pada ukuran teks terbesar, layar tersusun ulang dengan rapi alih-alih terpotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con le dimensioni di testo più grandi, le schermate si riorganizzano bene senza tagliare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字をいちばん大きくしても、切れずにきれいに並び直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 아주 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med de største tekststørrelsene ordner skjermene seg pent i stedet for å bli kuttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelfs bij de grootste tekstgroottes worden schermen netjes opnieuw ingedeeld in plaats van afgesneden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet przy największych rozmiarach tekstu ekrany przeukładają się porządnie, zamiast być ucinane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo nos maiores tamanhos de texto, as telas se reorganizam direitinho em vez de serem cortadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при самом крупном шрифте экраны аккуратно перестраиваются и ничего не обрезается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även med de största textstorlekarna ordnas skärmarna snyggt om i stället för att klippas av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ขยายตัวอักษรใหญ่ที่สุด หน้าจอก็จัดเรียงใหม่อย่างเรียบร้อยแทนที่จะถูกตัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En büyük yazı boyutlarında bile ekranlar kesilmek yerine düzgünce yeniden yerleşir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngay cả với cỡ chữ lớn nhất, màn hình vẫn sắp xếp lại gọn gàng thay vì bị cắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使把字号调到最大，界面也会重新排版，不会被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使把字級調到最大，介面也會重新排版，不會被截斷。"
          }
        }
      }
    },
    "글자를 아주 키워도 설정이 잘리지 않고, 대비 증가를 켜면 글자와 불씨가 더 진해져요." : {
      "comment" : "What's new 1.2.1: accessibility detail",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení se při velmi velkém textu už neořezává a Zvýšit kontrast ztmaví text i uhlíky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger bliver ikke længere skåret af ved meget stor tekst, og Øg kontrast gør tekst og gløder mørkere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen werden bei sehr großer Schrift nicht mehr abgeschnitten, und „Kontrast erhöhen“ macht Text und Glut dunkler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Ρυθμίσεις δεν κόβονται πια σε πολύ μεγάλα μεγέθη κειμένου και η Αύξηση αντίθεσης σκουραίνει το κείμενο και τα κάρβουνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings no longer get cut off at very large text sizes, and Increase Contrast makes text and embers darker."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings no longer get cut off at very large text sizes, and Increase Contrast makes text and embers darker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes ya no se cortan con tamaños de texto muy grandes, y Aumentar contraste oscurece el texto y las brasas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetukset eivät enää leikkaudu erittäin suurella tekstillä, ja Lisää kontrastia tummentaa tekstin ja hiilet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Réglages ne sont plus coupés avec de très grandes tailles de texte, et Augmenter le contraste assombrit le texte et les braises."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan tidak lagi terpotong pada ukuran teks yang sangat besar, dan Tambah Kontras membuat teks dan bara lebih gelap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Impostazioni non vengono più tagliate con testo molto grande e Aumenta contrasto rende testo e braci più scuri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字をとても大きくしても設定が切れず、「コントラストを上げる」をオンにすると文字と火種がより濃くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자를 아주 키워도 설정이 잘리지 않고, 대비 증가를 켜면 글자와 불씨가 더 진해져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger blir ikke lenger kuttet ved svært stor tekst, og Øk kontrast gjør tekst og glør mørkere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen worden bij heel grote tekst niet meer afgesneden en Verhoog contrast maakt tekst en kooltjes donkerder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia nie są już ucinane przy bardzo dużym tekście, a Zwiększ kontrast przyciemnia tekst i żar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Ajustes não são mais cortados com textos muito grandes, e Aumentar Contraste deixa o texto e as brasas mais escuros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки больше не обрезаются при очень крупном шрифте, а «Повышение контрастности» делает текст и угольки темнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar klipps inte längre av vid mycket stor text, och Öka kontrast gör text och glöd mörkare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่าไม่ถูกตัดอีกต่อไปเมื่อใช้ตัวอักษรใหญ่มาก และเพิ่มคอนทราสต์จะทำให้ตัวอักษรและถ่านไฟเข้มขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok büyük yazıda Ayarlar artık kesilmiyor, Karşıtlığı Artır ise yazıyı ve közleri koyulaştırıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt không còn bị cắt ở cỡ chữ rất lớn, và Tăng độ tương phản làm chữ và đốm than đậm hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字号调到很大，设置界面也不会被截断；开启“增强对比度”后，文字和余烬会更深更清晰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字級調到很大，設定介面也不會被截斷；開啟「增強對比度」後，文字和餘燼會更深更清晰。"
          }
        }
      }
    },
