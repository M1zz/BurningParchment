    "연결을 끊으려면 iOS 설정 ▸ 건강 ▸ 데이터 접근 및 기기에서 바꿀 수 있어요" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To disconnect, go to iOS Settings ▸ Health ▸ Data Access & Devices"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 끊으려면 iOS 설정 ▸ 건강 ▸ 데이터 접근 및 기기에서 바꿀 수 있어요"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を解除するには、iOSの設定 ▸ ヘルスケア ▸ データアクセスとデバイス から変更できます"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To disconnect, go to iOS Settings ▸ Health ▸ Data Access & Devices"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desconectar, ve a Ajustes de iOS ▸ Salud ▸ Acceso a datos y dispositivos"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Trennen: iOS-Einstellungen ▸ Health ▸ Datenzugriff & Geräte"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需断开连接，请前往 iOS 设置 ▸ 健康 ▸ 数据访问与设备 进行更改"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需斷開連線，請前往 iOS 設定 ▸ 健康 ▸ 資料存取與裝置 進行更改"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы отключить, откройте «Настройки» iOS ▸ «Здоровье» ▸ «Доступ к данным и устройства»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
