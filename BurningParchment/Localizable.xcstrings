    "달빛 한지, 청자, 노을. 양피지와 불꽃의 빛깔을 바꿔요." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měsíční hanji, celadon, soumrak. Mění barvu papíru i plamene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måneskins-hanji, celadon, solnedgang. Skift farven på papiret og flammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondlicht-Hanji, Seladon, Abendrot. Ändere die Farbe von Papier und Flamme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χάντζι του φεγγαριού, σελαντόν, δειλινό. Αλλάζουν το χρώμα του χαρτιού και της φλόγας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlit Hanji, Celadon, Dusk. Change the color of the paper and the flame."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlit Hanji, Celadon, Dusk. Change the colour of the paper and the flame."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanji a la luz de la luna, Celadón y Atardecer. Cambia el color del papel y de la llama."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuutamo-hanji, seladoni, hämärä. Vaihtavat paperin ja liekin värin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanji au clair de lune, céladon, crépuscule. Changez la couleur du papier et de la flamme."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanji Cahaya Bulan, Celadon, Senja. Mengubah warna kertas dan api."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanji al chiaro di luna, celadon, tramonto. Cambia il colore della carta e della fiamma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月明かりの韓紙、青磁、夕焼け。羊皮紙と炎の色合いを変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "달빛 한지, 청자, 노을. 양피지와 불꽃의 빛깔을 바꿔요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måneskinns-hanji, celadon, solnedgang. Endrer fargen på papiret og flammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maanlicht-hanji, celadon, schemering. Verandert de kleur van het papier en de vlam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Księżycowe hanji, seladon, zmierzch. Zmieniają kolor papieru i płomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanji ao luar, celadon, entardecer. Muda a cor do papel e da chama."
          }
