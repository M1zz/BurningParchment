        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 아침, 양피지 상단에 띠로 떠올라 하루와 함께 타들어가요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の朝、羊皮紙の上に帯として現れ、一日と一緒に燃えていきます。"
