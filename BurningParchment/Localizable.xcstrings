    "잠자는 시간과 겹쳐요. 깨어 있는 시간 안으로 잡아 주세요." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překrývá se to s vaším spánkem. Držte to v době bdění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det overlapper din søvn. Hold det inden for din vågne tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das überschneidet sich mit deinem Schlaf. Bleibe innerhalb deiner Wachzeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικαλύπτεται με τον ύπνο σας. Κρατήστε την μέσα στις ώρες εγρήγορσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This overlaps your sleep. Keep it within your waking hours."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This overlaps your sleep. Keep it within your waking hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincide con tu hora de sueño. Mantenlo dentro de tus horas de vigilia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä menee päällekkäin unesi kanssa. Pidä se valveillaoloaikasi sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela chevauche votre sommeil. Gardez-le dans vos heures d’éveil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini tumpang tindih dengan waktu tidurmu. Tetaplah di dalam jam terjaga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sovrappone al tuo sonno. Tienila entro le ore di veglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠時間と重なっています。起きている時間内に設定してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette overlapper med søvnen din. Hold det innenfor våken tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit overlapt met je slaap. Houd het binnen je wakkere uren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To pokrywa się z Twoim snem. Zmieść to w godzinach na jawie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso se sobrepõe ao seu sono. Mantenha dentro das horas acordado."
          }
        },
        "ru" : {
          "stringUnit" : {
