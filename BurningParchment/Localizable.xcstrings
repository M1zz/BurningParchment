    "어젯밤 %@ 늦게 잠들어\n오늘 아침이 그을렸어요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Včera v noci jste usnuli o %@ později,\\ntakže dnešní ráno je přiškvařené"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du faldt i søvn %@ for sent i nat,\\nså morgenen i dag er svedet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist letzte Nacht %@ später eingeschlafen,\ndeshalb ist dieser Morgen angesengt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χθες βράδυ κοιμηθήκατε %@ αργότερα,\\nοπότε το σημερινό πρωινό έχει ζεματιστεί"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late last night,\nso this morning is scorched"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late last night,\nso this morning is scorched"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anoche te dormiste %@ tarde,\npor eso esta mañana está chamuscada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nukahdit viime yönä %@ myöhemmin,\\njoten tämä aamu on kärähtänyt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes endormi(e) %@ trop tard hier soir,\\ndonc ce matin est roussi"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semalam kamu tidur %@ lebih larut,\\njadi pagi ini hangus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieri notte ti sei addormentato/a %@ più tardi,\\nquindi stamattina è bruciacchiata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨夜は%@遅く眠ったので、\n今朝は焦げてしまいました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
