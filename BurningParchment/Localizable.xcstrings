    "무료로는 데드라인을 %lld개까지 둘 수 있어요. 프로로 여러 목표를 함께 세어보세요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free version keeps up to %lld deadline. With Pro, count down to as many goals as you like."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료로는 데드라인을 %lld개까지 둘 수 있어요. 프로로 여러 목표를 함께 세어보세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料版では締め切りを%lld件まで設定できます。Proなら複数の目標を一緒にカウントダウンできます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free version keeps up to %lld deadline. With Pro, count down to as many goals as you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión gratuita admite hasta %lld fecha límite. Con Pro puedes contar hacia todas las metas que quieras."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kostenlose Version erlaubt bis zu %lld Deadline. Mit Pro zählst du beliebig viele Ziele herunter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费版最多可设 %lld 个截止日期。升级 Pro，可以同时倒数多个目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免費版最多可設 %lld 個截止日期。升級 Pro，可以同時倒數多個目標。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно можно держать до %lld дедлайна. С Pro вы отсчитываете сколько угодно целей."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version gratuite garde jusqu’à %lld échéance. Avec Pro, décomptez autant d’objectifs que vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione gratuita permette fino a %lld scadenza. Con Pro conti alla rovescia quanti obiettivi vuoi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão gratuita permite até %lld prazo. Com o Pro, você conta quantas metas quiser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวอร์ชันฟรีตั้งกำหนดส่งได้ถึง %lld รายการ ด้วย Pro คุณนับถอยหลังได้หลายเป้าหมายตามต้องการ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản miễn phí giữ tối đa %lld hạn chót. Với Pro, bạn đếm ngược bao nhiêu mục tiêu tùy ý."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatná verze udrží až %lld termín. S Pro odpočítáváte tolik cílů, kolik chcete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gratis version rummer op til %lld frist. Med Pro kan du tælle ned til lige så mange mål, du vil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δωρεάν έκδοση κρατά έως και %lld προθεσμία. Με το Pro μετράτε αντίστροφα όσους στόχους θέλετε."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
