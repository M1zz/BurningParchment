        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você dormiu %@ mais tarde ontem à noite,\\npor isso a manhã de hoje ficou chamuscada"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคืนคุณหลับช้าไป %@\\nเช้านี้จึงไหม้เกรียม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đêm qua bạn ngủ muộn %@,\\nnên sáng nay bị cháy sém"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Včera v noci jste usnuli o %@ později,\\ntakže dnešní ráno je přiškvařené"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du faldt i søvn %@ for sent i nat,\\nså morgenen i dag er svedet"
