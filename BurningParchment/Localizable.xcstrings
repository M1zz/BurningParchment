    "수면 기록은 읽기만 하고 기기 밖으로 보내지 않아요" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záznamy o spánku se pouze čtou a nikdy neopustí vaše zařízení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvndata læses kun og forlader aldrig din enhed"
