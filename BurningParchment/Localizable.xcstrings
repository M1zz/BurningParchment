    "Face ID나 Touch ID로 앱을 잠가 내 회고를 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci přes Face ID nebo Touch ID, aby ohlédnutí zůstala soukromá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID for at holde dine refleksioner private."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID, damit deine Rückblicke privat bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλειδώστε την εφαρμογή με Face ID ή Touch ID για να μένουν ιδιωτικοί οι απολογισμοί σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your reflections private."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your reflections private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para mantener privadas tus reflexiones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse sovellus Face ID:llä tai Touch ID:llä pitääksesi pohdintasi yksityisinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez l’app avec Face ID ou Touch ID pour garder vos bilans privés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci aplikasi dengan Face ID atau Touch ID agar refleksimu tetap pribadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca l’app con Face ID o Touch ID per tenere private le tue riflessioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDやTouch IDでアプリをロックして、ふりかえりを守ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID나 Touch ID로 앱을 잠가 내 회고를 지켜요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID for å holde refleksjonene dine private."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendel de app met Face ID of Touch ID om je reflecties privé te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokuj aplikację za pomocą Face ID lub Touch ID, aby refleksje pozostały prywatne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie o app com Face ID ou Touch ID para manter suas reflexões privadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
