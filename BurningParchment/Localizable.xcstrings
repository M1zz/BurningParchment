        }
      }
    },
    "항아리는 이미 준비돼 있어요.\n첫 재는 %@ 항아리에 담깁니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urna už čeká.\\nPrvní popel půjde do urny %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urnen venter allerede.\\nDin første aske kommer i %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Urne steht schon bereit.\nDeine erste Asche kommt in die Urne %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τεφροδοχείο περιμένει ήδη.\\nΗ πρώτη σας στάχτη θα μπει στο «%@»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The urn is already waiting.\nYour first ash goes into %@."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The urn is already waiting.\nYour first ash goes into %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La urna ya te espera.\nTu primera ceniza irá a %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uurna odottaa jo.\\nEnsimmäinen tuhkasi menee uurnaan %@."
