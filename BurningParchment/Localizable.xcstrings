    "%@ — 아직 어느 항아리에도 담기지 않은 시간이에요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — time that hasn't gone into any urn yet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 아직 어느 항아리에도 담기지 않은 시간이에요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — まだどの壺にも入っていない時間です。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — time that hasn't gone into any urn yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
