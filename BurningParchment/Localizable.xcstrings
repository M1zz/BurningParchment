    },
    "잠·일·해야 할 일을 빼고, 온전히 나를 위해 쓰는 시간만 적어 주세요. 이 시간이 지나갈 때만 이번 주 양피지가 타요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave out sleep, work and chores, and add only the time you spend on yourself. This week's parchment burns only while it passes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠・仕事・やるべきことを除いて、自分のためだけに使う時間を入力してください。この時間が過ぎるときだけ、今週の羊皮紙が燃えます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave out sleep, work and chores, and add only the time you spend on yourself. This week's parchment burns only while it passes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja fuera el sueño, el trabajo y las tareas, y añade solo el tiempo que dedicas a ti. El pergamino de esta semana arde solo mientras ese tiempo pasa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Schlaf, Arbeit und Pflichten weg und trage nur die Zeit ein, die du für dich selbst nutzt. Das Pergament dieser Woche brennt nur, solange sie vergeht."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请排除睡觉、工作和杂事，只填写完全为自己所用的时间。只有这段时间流逝时，本周的羊皮纸才会燃烧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請排除睡覺、工作和雜事，只填寫完全為自己所用的時間。只有這段時間流逝時，本週的羊皮紙才會燃燒。"
          }
        }
      }
    },
    "잠과 일을 뺀 진짜 내 시간을 골라 두면, 그 시간이 지나갈 때만 이번 주 양피지가 타요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the hours that are truly yours, beyond sleep and work. This week's parchment burns only while they pass."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠と仕事を除いた本当の自分の時間を選んでおくと、その時間が過ぎるときだけ今週の羊皮紙が燃えます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the hours that are truly yours, beyond sleep and work. This week's parchment burns only while they pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las horas que de verdad son tuyas, más allá del sueño y el trabajo. El pergamino de esta semana arde solo mientras pasan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Stunden, die wirklich dir gehören, abseits von Schlaf und Arbeit. Das Pergament dieser Woche brennt nur, solange sie vergehen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选好扣除睡眠和工作之后真正属于你的时间，只有这段时间流逝时，本周的羊皮纸才会燃烧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選好扣除睡眠和工作之後真正屬於你的時間，只有這段時間流逝時，本週的羊皮紙才會燃燒。"
          }
        }
      }
    },
