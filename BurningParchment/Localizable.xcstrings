        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những gì ở đây chỉ là tro cho đến khi bạn đặt tên cho chúng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
