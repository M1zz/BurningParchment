    "어젯밤 %@ 늦게 잠들어\n오늘 아침이 그을렸어요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late last night,\nso this morning is scorched"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어젯밤 %@ 늦게 잠들어\n오늘 아침이 그을렸어요"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨夜は%@遅く眠ったので、\n今朝は焦げてしまいました"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late last night,\nso this morning is scorched"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anoche te dormiste %@ tarde,\npor eso esta mañana está chamuscada"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist letzte Nacht %@ später eingeschlafen,\ndeshalb ist dieser Morgen angesengt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚晚睡了 %@，\n今天早晨留下了焦痕"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚晚睡了 %@，\n今天早晨留下了焦痕"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы легли на %@ позже,\\nпоэтому утро обожжено"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes endormi(e) %@ trop tard hier soir,\\ndonc ce matin est roussi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieri notte ti sei addormentato/a %@ più tardi,\\nquindi stamattina è bruciacchiata"
