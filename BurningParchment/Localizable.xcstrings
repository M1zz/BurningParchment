    "원하면 앱 안에서 회고와 데드라인을 모두 지울 수 있어요." : {
      "comment" : "Roadmap item detail: delete all my data",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdykoli můžete přímo v aplikaci smazat všechna ohlédnutí a termíny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet alle dine refleksioner og frister direkte i appen, når du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche alle Rückblicke und Deadlines jederzeit direkt in der App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράψτε όλους τους απολογισμούς και τις προθεσμίες απευθείας στην εφαρμογή, όποτε θέλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase all your reflections and deadlines right in the app whenever you want."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase all your reflections and deadlines right in the app whenever you want."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra todas tus reflexiones y fechas límite desde la app cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista kaikki pohdinnat ja määräajat suoraan sovelluksessa milloin haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacez tous vos bilans et échéances directement dans l’app, quand vous voulez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus semua refleksi dan tenggat langsung di aplikasi kapan pun kamu mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella tutte le riflessioni e le scadenze direttamente nell’app, quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なときに、アプリ内でふりかえりと締め切りをすべて削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하면 앱 안에서 회고와 데드라인을 모두 지울 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slett alle refleksjoner og frister rett i appen når du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wis al je reflecties en deadlines direct in de app wanneer je maar wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń wszystkie refleksje i terminy bezpośrednio w aplikacji, kiedy chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
