    "%@ 늦게 잠들었어요. 그만큼 오늘 아침이 그을려요" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šli jste spát o %@ později. Dnešní ráno je o tolik přiškvařené"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du faldt i søvn %@ for sent. Morgenen i dag er svedet af tilsvarende"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist %@ später eingeschlafen. Um so viel ist dieser Morgen angesengt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοιμηθήκατε %@ αργότερα. Το σημερινό πρωινό έχει ζεματιστεί κατά τόσο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late. This morning is scorched by that much"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late. This morning is scorched by that much"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te dormiste %@ tarde. Esta mañana queda chamuscada en esa medida"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nukahdit %@ myöhemmin. Tämän aamun pergamentti on kärähtänyt saman verran"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes endormi(e) %@ trop tard. Ce matin est roussi d’autant"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidur %@ lebih larut. Pagi ini hangus sebanyak itu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti sei addormentato/a %@ più tardi. Stamattina è bruciacchiata di altrettanto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@遅く眠りました。そのぶん今朝が焦げています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 늦게 잠들었어요. 그만큼 오늘 아침이 그을려요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sovnet %@ for sent. Morgenen i dag er svidd tilsvarende"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ging %@ later slapen. Vanochtend is dat evenveel verschroeid"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poszedłeś/aś spać o %@ później. Dzisiejszy poranek jest przypalony o tyle samo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você dormiu %@ mais tarde. A manhã de hoje ficou chamuscada na mesma medida"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы легли на %@ позже. Утро обожжено на столько же"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du somnade %@ för sent. Morgonen i dag är svedd lika mycket"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณหลับช้าไป %@ เช้านี้จึงไหม้เกรียมตามนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ daha geç uyudun. Bu sabah o kadar yanık"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn ngủ muộn %@. Sáng nay bị cháy sém chừng đó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你晚睡了 %@，今天早晨因此留下了焦痕"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你晚睡了 %@，今天早晨因此留下了焦痕"
          }
        }
      }
    },
    "%@ 이후 내일의 양피지가 탔어요.\n잠든 시각만큼만 그을음으로 남겨요." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zítřejší pergamen shořel po %@.\\nPřiškvařený zůstává jen čas, kdy jste byli vzhůru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I morgens pergament brændte efter %@.\\nKun den tid, du var vågen, efterlader en svidning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Pergament von morgen ist nach %@ verbrannt.\nNur die Zeit, die du wach geblieben bist, hinterlässt einen Brandfleck."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η περγαμηνή του αύριο κάηκε μετά τις %@.\\nΜόνο ο χρόνος που μείνατε ξύπνιοι αφήνει καψάλισμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow's parchment burned after %@.\nOnly the time you stayed up leaves a scorch."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow's parchment burnt after %@.\nOnly the time you stayed up leaves a scorch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pergamino de mañana ardió después de las %@.\nSolo el tiempo que seguiste despierto deja chamusquina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomisen pergamentti paloi kello %@ jälkeen.\\nVain valvottu aika jättää käryn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parchemin de demain a brûlé après %@.\\nSeul le temps passé éveillé laisse une trace de roussi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkamen besok terbakar setelah %@.\\nHanya waktu saat kamu terjaga yang meninggalkan bekas hangus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pergamena di domani è bruciata dopo le %@.\\nSolo il tempo passato sveglio lascia una bruciatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以降、明日の羊皮紙が燃えました。\n夜更かしした時間だけ焦げ跡が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이후 내일의 양피지가 탔어요.\n잠든 시각만큼만 그을음으로 남겨요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I morgens pergament brant etter %@.\\nBare tiden du var våken, setter svidde spor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het perkament van morgen brandde na %@.\\nAlleen de tijd dat je wakker was, laat schroeiplekken achter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutrzejszy pergamin spłonął po %@.\\nPrzypalenie zostawia tylko czas, gdy nie spałeś/aś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pergaminho de amanhã queimou depois de %@.\\nSó o tempo que você ficou acordado deixa chamuscado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пергамент на завтра горел после %@.\\nСажа остаётся только за часы бодрствования."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgondagens pergament brann efter %@.\\nBara tiden du var vaken lämnar en sviden fläck."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระดาษหนังของพรุ่งนี้ไหม้หลัง %@\\nรอยไหม้เกิดจากเวลาที่ยังตื่นอยู่เท่านั้น"
          }
