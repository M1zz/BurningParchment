    "재를 몇 톨 담으면\n분포와 잔불 달력이 여기에 나타나요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uschovejte trochu popela a\\nzde se objeví rozložení a kalendář uhlíků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem lidt aske, så vises\\nfordelingen og glødekalenderen her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammle ein paar Aschekörnchen,\ndann erscheinen hier die Verteilung und der Glutkalender."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε λίγη στάχτη και\\nεδώ θα εμφανιστούν η κατανομή και το ημερολόγιο με τα κάρβουνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a few ashes and\nthe distribution and ember calendar will appear here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a few ashes and\nthe distribution and ember calendar will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda unas cuantas cenizas y\naquí aparecerán la distribución y el calendario de brasas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä vähän tuhkaa, niin\\njakauma ja hiilikalenteri ilmestyvät tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez quelques cendres et\\nla répartition et le calendrier des braises apparaîtront ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan sedikit abu dan\\nsebaran serta kalender baranya akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva un po’ di cenere e\\nla distribuzione e il calendario delle braci appariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灰をいくつか入れると\n分布と火種のカレンダーがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재를 몇 톨 담으면\n분포와 잔불 달력이 여기에 나타나요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta vare på litt aske, så vises\\nfordelingen og glødkalenderen her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar wat as en\\nde verdeling en de gloeikalender verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj trochę popiołu, a\\nrozkład i kalendarz żaru pojawią się tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde algumas cinzas e\\na distribuição e o calendário de brasas aparecerão aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
