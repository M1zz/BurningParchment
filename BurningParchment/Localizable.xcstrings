          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sovnet %@ for sent i natt,\\nså morgenen i dag er svidd"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
