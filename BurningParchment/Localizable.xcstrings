    "정해 보고 셈을 보는 건 무료예요. 그 시간만 태우는 건 프로예요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setting it up and seeing the numbers is free. Burning only those hours is Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定して計算を見るのは無料です。その時間だけを燃やすのはProの機能です。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
