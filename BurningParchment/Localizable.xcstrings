    "%@ — 아직 어느 항아리에도 담기지 않은 시간이에요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — time that hasn't gone into any urn yet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 아직 어느 항아리에도 담기지 않은 시간이에요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — まだどの壺にも入っていない時間です。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — time that hasn't gone into any urn yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: tiempo que aún no ha ido a ninguna urna."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – Zeit, die noch in keiner Urne gelandet ist."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 还没有放进任何灰罐的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 還沒有放進任何灰罐的時間。"
          }
        }
      }
    },
    "%@ 늦게 잠들었어요. 그만큼 오늘 아침이 그을려요" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late. This morning is scorched by that much"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 늦게 잠들었어요. 그만큼 오늘 아침이 그을려요"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@遅く眠りました。そのぶん今朝が焦げています"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You fell asleep %@ late. This morning is scorched by that much"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te dormiste %@ tarde. Esta mañana queda chamuscada en esa medida"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist %@ später eingeschlafen. Um so viel ist dieser Morgen angesengt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你晚睡了 %@，今天早晨因此留下了焦痕"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你晚睡了 %@，今天早晨因此留下了焦痕"
          }
        }
      }
    },
    "%@ 이후 내일의 양피지가 탔어요.\n잠든 시각만큼만 그을음으로 남겨요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow's parchment burned after %@.\nOnly the time you stayed up leaves a scorch."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이후 내일의 양피지가 탔어요.\n잠든 시각만큼만 그을음으로 남겨요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以降、明日の羊皮紙が燃えました。\n夜更かしした時間だけ焦げ跡が残ります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow's parchment burnt after %@.\nOnly the time you stayed up leaves a scorch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pergamino de mañana ardió después de las %@.\nSolo el tiempo que seguiste despierto deja chamusquina."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Pergament von morgen ist nach %@ verbrannt.\nNur die Zeit, die du wach geblieben bist, hinterlässt einen Brandfleck."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 之后，明天的羊皮纸已经烧起来了。\n只把熬夜的时长留作焦痕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 之後，明天的羊皮紙已經燒起來了。\n只把熬夜的時長留作焦痕。"
          }
        }
      }
    },
