    "이번 주, 이번 달, 올해 남은 시간도 같은 양피지로 볼 수 있어요." : {
      "comment" : "Tip message: swiping shows week, month and year",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbytek tohoto týdne, měsíce a roku uvidíte na stejném pergamenu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, hvad der er tilbage af denne uge, måned og år, på det samme pergament."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh die verbleibende Zeit dieser Woche, dieses Monats und dieses Jahres auf demselben Pergament."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε τι απομένει από αυτή την εβδομάδα, τον μήνα και το έτος στην ίδια περγαμηνή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what's left of this week, month, and year on the same parchment."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what's left of this week, month, and year on the same parchment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira lo que queda de esta semana, este mes y este año en el mismo pergamino."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe tämän viikon, kuukauden ja vuoden jäljellä oleva aika samalla pergamentilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez ce qu’il reste de la semaine, du mois et de l’année sur le même parchemin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat sisa minggu, bulan, dan tahun ini pada perkamen yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi cosa resta di questa settimana, mese e anno sulla stessa pergamena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週・今月・今年の残り時間も、同じ羊皮紙で見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주, 이번 달, 올해 남은 시간도 같은 양피지로 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hva som er igjen av denne uken, måneden og året på det samme pergamentet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie wat er nog over is van deze week, maand en jaar op hetzelfde perkament."
