          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca urne e scadenze illimitate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壺と締め切りを無制限に使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항아리·데드라인 무제한을 이용해보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
