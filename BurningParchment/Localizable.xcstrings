    "답하지 않고 닫아도 괜찮아요. 확인되지 않은 밤은 그을음 없이 넘어가요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavřít můžete i bez odpovědi. Nepotvrzené noci proběhnou bez přiškvaření."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan roligt lukke uden at svare. Ubekræftede nætter går uden svidning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst schließen, ohne zu antworten. Nicht bestätigte Nächte vergehen ohne Brandfleck."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να κλείσετε χωρίς να απαντήσετε. Οι νύχτες που δεν επιβεβαιώθηκαν περνούν χωρίς καψάλισμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's fine to close this without answering. Unconfirmed nights pass without any scorch."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's fine to close this without answering. Unconfirmed nights pass without any scorch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cerrar sin responder. Las noches sin confirmar pasan sin chamusquina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit sulkea vastaamatta. Vahvistamattomat yöt kuluvat ilman käryä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez fermer sans répondre. Les nuits non confirmées passent sans trace de roussi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak apa-apa menutup tanpa menjawab. Malam yang tidak dikonfirmasi lewat tanpa bekas hangus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi chiudere senza rispondere. Le notti non confermate passano senza bruciature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "答えずに閉じても大丈夫です。確認できなかった夜は焦げ跡なしで過ぎていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답하지 않고 닫아도 괜찮아요. 확인되지 않은 밤은 그을음 없이 넘어가요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan lukke uten å svare. Ubekreftede netter går forbi uten svidd spor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mag sluiten zonder te antwoorden. Niet-bevestigde nachten gaan voorbij zonder schroeiplek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zamknąć bez odpowiadania. Niepotwierdzone noce mijają bez przypalenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo bem fechar sem responder. Noites não confirmadas passam sem chamuscado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно закрыть и не отвечать. Неподтверждённые ночи проходят без сажи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går bra att stänga utan att svara. Obekräftade nätter går förbi utan svedda fläckar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดโดยไม่ตอบก็ได้ คืนที่ไม่ได้ยืนยันจะผ่านไปโดยไม่มีรอยไหม้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cevaplamadan kapatabilirsin. Onaylanmayan geceler yanık izi bırakmadan geçer."
