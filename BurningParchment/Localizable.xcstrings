          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấy da ngày mai đã cháy sau %@.\\nChỉ phần thời gian bạn thức mới để lại vết cháy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 之后，明天的羊皮纸已经烧起来了。\n只把熬夜的时长留作焦痕。"
