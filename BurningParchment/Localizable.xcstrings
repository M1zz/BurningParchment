    "여기 담긴 것들은 당신이 이름을 붙이기 전까진 그냥 재예요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is in here stays just ash until you name it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 담긴 것들은 당신이 이름을 붙이기 전까진 그냥 재예요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにあるものは、あなたが名前をつけるまでただの灰です。"
