    "재를 몇 톨 담으면\n분포와 잔불 달력이 여기에 나타나요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a few ashes and\nthe distribution and ember calendar will appear here."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재를 몇 톨 담으면\n분포와 잔불 달력이 여기에 나타나요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灰をいくつか入れると\n分布と火種のカレンダーがここに表示されます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a few ashes and\nthe distribution and ember calendar will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda unas cuantas cenizas y\naquí aparecerán la distribución y el calendario de brasas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammle ein paar Aschekörnchen,\ndann erscheinen hier die Verteilung und der Glutkalender."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存入几粒灰烬后，\n分布图和余烬日历就会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存入幾粒灰燼後，\n分佈圖和餘燼日曆就會出現在這裡。"
          }
        }
      }
    },
