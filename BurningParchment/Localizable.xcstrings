    "이 Apple 계정으로 프로를 산 기록을 찾지 못했어요. 구매할 때 쓴 계정으로 로그인했는지 확인해주세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find a Pro purchase on this Apple Account. Make sure you're signed in with the account you used to buy it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Apple 계정으로 프로를 산 기록을 찾지 못했어요. 구매할 때 쓴 계정으로 로그인했는지 확인해주세요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple アカウントでProを購入した記録が見つかりませんでした。購入時のアカウントでサインインしているかご確認ください。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find a Pro purchase on this Apple Account. Make sure you're signed in with the account you used to buy it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos una compra de Pro en esta cuenta de Apple. Comprueba que hayas iniciado sesión con la cuenta que usaste para comprarlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Apple-Account wurde kein Pro-Kauf gefunden. Prüfe, ob du mit dem Account angemeldet bist, mit dem du gekauft hast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个 Apple 账户下没有找到购买 Pro 的记录。请确认登录的是购买时使用的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 Apple 帳號下沒有找到購買 Pro 的記錄。請確認登入的是購買時使用的帳號。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого аккаунта Apple покупка Pro не найдена. Убедитесь, что вы вошли в аккаунт, с которого покупали."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’avons trouvé aucun achat Pro sur ce compte Apple. Vérifiez que vous êtes connecté(e) avec le compte utilisé pour l’achat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo trovato un acquisto Pro su questo Apple Account. Verifica di aver effettuato l’accesso con l’account usato per l’acquisto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encontramos uma compra do Pro nesta conta Apple. Confira se você entrou com a conta usada na compra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบการซื้อ Pro ใน Apple Account นี้ โปรดตรวจสอบว่าเข้าสู่ระบบด้วยบัญชีที่ใช้ซื้อ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi không tìm thấy giao dịch mua Pro trên tài khoản Apple này. Hãy kiểm tra bạn đã đăng nhập bằng tài khoản dùng để mua."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto účtu Apple jsme nenašli nákup Pro. Ověřte, že jste přihlášeni účtem, kterým jste nakupovali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fandt ikke noget Pro-køb på denne Apple-konto. Tjek, at du er logget ind med den konto, du købte med."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρήκαμε αγορά Pro σε αυτόν τον λογαριασμό Apple. Βεβαιωθείτε ότι έχετε συνδεθεί με τον λογαριασμό που χρησιμοποιήσατε για την αγορά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tältä Apple-tililtä ei löytynyt Pro-ostoa. Varmista, että olet kirjautunut sillä tilillä, jolla ostit sen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak menemukan pembelian Pro di Akun Apple ini. Pastikan kamu masuk dengan akun yang dipakai untuk membeli."
          }
        }
      }
    },
