          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuj nieograniczone urny i terminy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie urnas e prazos ilimitados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте безлимитные урны и дедлайны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
