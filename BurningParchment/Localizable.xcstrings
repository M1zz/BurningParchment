    "회고 %lld개. 마음먹은 대로 했어 %lld퍼센트, 어쩌다 하게 됐어 %lld퍼센트, 하려 했는데 못 했어 %lld퍼센트, 그냥 흘러갔어 %lld퍼센트" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflections: %lld. Did what I intended %lld percent, ended up doing it %lld percent, tried but didn't %lld percent, just slipped away %lld percent"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회고 %lld개. 마음먹은 대로 했어 %lld퍼센트, 어쩌다 하게 됐어 %lld퍼센트, 하려 했는데 못 했어 %lld퍼센트, 그냥 흘러갔어 %lld퍼센트"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふりかえり %lld件。思いどおりにできた %lld％、たまたまできた %lld％、やろうとしたけどできなかった %lld％、なんとなく過ぎた %lld％"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflections: %lld. Did what I intended %lld percent, ended up doing it %lld percent, tried but didn't %lld percent, just slipped away %lld percent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexiones: %lld. Hice lo que quería: %lld por ciento. Terminé haciéndolo: %lld por ciento. Lo intenté, pero no: %lld por ciento. Simplemente se fue: %lld por ciento"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückblicke: %lld. Wie geplant geschafft %lld Prozent, einfach getan %lld Prozent, gewollt, aber nicht getan %lld Prozent, einfach verflogen %lld Prozent"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %lld 条回顾。按心意做了百分之 %lld，不知不觉做了百分之 %lld，本想做却没做成百分之 %lld，就这么过去了百分之 %lld"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %lld 條回顧。按心意做了百分之 %lld，不知不覺做了百分之 %lld，本想做卻沒做成百分之 %lld，就這麼過去了百分之 %lld"
          }
        }
      }
    },
