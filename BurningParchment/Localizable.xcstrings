    "대비를 높이거나 색을 구별하기 어려워도 타들어 가는 시간을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: better colors and contrast",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hořící čas je dobře vidět, i když zapnete Zvýšit kontrast nebo se barvy špatně rozlišují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tydeligt, hvordan din tid brænder, selv med Øg kontrast slået til, eller hvis farver er svære at skelne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne deine verbrennende Zeit klar, auch mit „Kontrast erhöhen“ oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε καθαρά τον χρόνο σας να καίγεται, ακόμη και με ενεργή την Αύξηση αντίθεσης ή αν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your time burning away clearly, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your time burning away clearly, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue con claridad tu tiempo en llamas, incluso con Aumentar contraste o si te cuesta diferenciar colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe palava aikasi selvästi, vaikka Lisää kontrastia olisi päällä tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez clairement votre temps brûler, même avec Augmenter le contraste ou si les couleurs sont difficiles à distinguer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat waktumu yang terbakar dengan jelas, bahkan saat Tambah Kontras aktif atau saat warna sulit dibedakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi chiaramente il tempo che brucia, anche con Aumenta contrasto attivo o se fai fatica a distinguere i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げていても、色の区別が難しくても、燃えていく時間がわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 타들어 가는 시간을 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tydelig hvordan tiden din brenner, selv med Øk kontrast på eller hvis farger er vanskelige å skille."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie je brandende tijd duidelijk, ook met Verhoog contrast aan of als kleuren moeilijk te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyraźnie widzisz płonący czas, nawet gdy włączono Zwiększ kontrast lub trudno odróżnić kolory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja claramente seu tempo queimando, mesmo com Aumentar Contraste ligado ou se for difícil distinguir cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время, которое горит, хорошо видно даже при повышенной контрастности или если трудно различать цвета."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tydligt hur din tid brinner, även med Öka kontrast på eller om färger är svåra att skilja åt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เห็นเวลาที่กำลังไหม้ชัดเจน แม้เปิดเพิ่มคอนทราสต์ หรือแยกสีได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
