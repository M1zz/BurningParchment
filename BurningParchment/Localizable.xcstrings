    "수면 기록은 읽기만 하고 기기 밖으로 보내지 않아요" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep records are only read and never leave your device"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
