    "여기 담긴 것들은 당신이 이름을 붙이기 전까진 그냥 재예요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is in here stays just ash until you name it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 담긴 것들은 당신이 이름을 붙이기 전까진 그냥 재예요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにあるものは、あなたが名前をつけるまでただの灰です。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is in here stays just ash until you name it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hay aquí seguirá siendo solo ceniza hasta que le pongas nombre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was hier liegt, bleibt nur Asche, bis du ihm einen Namen gibst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里面的东西，在你为它们命名之前，只是灰烬。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡面的東西，在你為它們命名之前，只是灰燼。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что здесь, — просто пепел, пока вы не дадите ему имя."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est ici reste de la cendre tant que vous ne lui avez pas donné un nom."
