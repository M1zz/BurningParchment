    "항아리·데드라인 무제한을 이용해보세요." : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odemkněte neomezené urny a termíny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås ubegrænsede urner og frister op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte unbegrenzt viele Urnen und Deadlines frei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκλειδώστε απεριόριστα τεφροδοχεία και προθεσμίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
