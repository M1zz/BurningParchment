    "일어난 순간부터 잠들 시각까지 양피지가 천천히 타요. 옆으로 밀면 이번 주, 이번 달, 올해도 볼 수 있어요." : {
      "comment" : "Onboarding page 1 detail",
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od vstávání do usnutí pergamen pomalu hoří. Přejetím do strany uvidíte týden, měsíc a rok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra du står op til sengetid brænder pergamentet langsomt ned. Stryg til siden for at se uge, måned og år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Aufwachen bis zur Schlafenszeit brennt das Pergament langsam ab. Wische zur Seite, um diese Woche, diesen Monat und dieses Jahr zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από το ξύπνημα ως την ώρα του ύπνου, η περγαμηνή καίγεται σιγά σιγά. Σύρετε προς τα πλάγια για να δείτε την εβδομάδα, τον μήνα και το έτος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From the moment you wake up until bedtime, the parchment slowly burns. Swipe sideways to see this week, month, and year."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From the moment you wake up until bedtime, the parchment slowly burns. Swipe sideways to see this week, month, and year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde que despiertas hasta que te duermes, el pergamino arde poco a poco. Desliza hacia los lados para ver esta semana, este mes y este año."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herätyksestä nukkumaanmenoon pergamentti palaa hitaasti. Pyyhkäise sivulle nähdäksesi viikon, kuukauden ja vuoden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du réveil au coucher, le parchemin brûle lentement. Balayez sur le côté pour voir la semaine, le mois et l’année."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari saat bangun hingga waktu tidur, perkamen terbakar perlahan. Gesek ke samping untuk melihat minggu, bulan, dan tahun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalla sveglia al riposo la pergamena brucia lentamente. Scorri di lato per vedere settimana, mese e anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起きた瞬間から寝る時間まで、羊皮紙がゆっくり燃えていきます。横にスワイプすると今週・今月・今年も見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일어난 순간부터 잠들 시각까지 양피지가 천천히 타요. 옆으로 밀면 이번 주, 이번 달, 올해도 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra du står opp til leggetid brenner pergamentet sakte ned. Sveip til siden for å se uke, måned og år."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van opstaan tot bedtijd brandt het perkament langzaam op. Veeg zijwaarts om de week, maand en het jaar te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od pobudki do pory snu pergamin powoli się spala. Przesuń w bok, aby zobaczyć tydzień, miesiąc i rok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do acordar até a hora de dormir, o pergaminho queima devagar. Deslize para o lado para ver a semana, o mês e o ano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От подъёма до отхода ко сну пергамент медленно горит. Листайте вбок, чтобы увидеть неделю, месяц и год."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från uppvaknandet till läggdags brinner pergamentet långsamt ner. Svep åt sidan för att se vecka, månad och år."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งแต่ตื่นจนถึงเวลานอน กระดาษหนังจะค่อย ๆ ไหม้ ปัดไปทางข้างเพื่อดูสัปดาห์ เดือน และปี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyanmaktan uyku saatine kadar parşömen yavaşça yanar. Haftayı, ayı ve yılı görmek için yana kaydır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ lúc thức dậy đến giờ đi ngủ, giấy da cháy dần. Vuốt sang ngang để xem tuần, tháng và năm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从起床到入睡，羊皮纸慢慢燃烧。左右滑动，还能查看本周、本月和今年。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從起床到入睡，羊皮紙慢慢燃燒。左右滑動，還能查看本週、本月和今年。"
          }
        }
      }
    },
