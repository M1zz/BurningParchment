        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañana por la mañana aparecerá como una banda sobre el pergamino y arderá junto con tu día."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen früh erscheint sie als Band über dem Pergament und brennt mit deinem Tag ab."
