          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trùng với giờ ngủ của bạn. Hãy giữ trong giờ thức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与睡眠时间重叠。请设在清醒时间内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與睡眠時間重疊。請設在清醒時間內。"
          }
        }
      }
    },
    "잠자는 시간도, 일하는 시간도 빼고\n정말 나만을 위한 시간만 골라 두세요.\n그 시간이 지나갈 때만 이번 주 양피지가 타요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez spánku, bez práce,\\nvyberte jen hodiny, které jsou vaše.\\nPergamen tohoto týdne hoří jen po dobu jejich plynutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden søvn, uden arbejde,\\nvælg kun de timer, der er dine.\\nDenne uges pergament brænder kun, mens de går."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Schlaf und Arbeit weg\nund wähle nur die Stunden, die dir gehören.\nDas Pergament dieser Woche brennt nur, solange sie vergehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς ύπνο, χωρίς δουλειά,\\nεπιλέξτε μόνο τις ώρες που είναι δικές σας.\\nΗ περγαμηνή αυτής της εβδομάδας καίγεται μόνο όσο περνούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave out sleep, leave out work,\nand pick only the hours that are yours.\nThis week's parchment burns only while they pass."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave out sleep, leave out work,\nand pick only the hours that are yours.\nThis week's parchment burns only while they pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja fuera el sueño y el trabajo,\ny elige solo las horas que son tuyas.\nEl pergamino de esta semana arde solo mientras pasan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilman unta, ilman työtä,\\nvalitse vain tunnit, jotka ovat sinun.\\nTämän viikon pergamentti palaa vain niiden kuluessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans le sommeil, sans le travail,\\nchoisissez seulement les heures qui sont à vous.\\nLe parchemin de cette semaine ne brûle que pendant qu’elles s’écoulent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa tidur, tanpa kerja,\\npilih hanya jam yang menjadi milikmu.\\nPerkamen minggu ini hanya terbakar selama jam itu berlalu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza sonno, senza lavoro,\\nscegli solo le ore che sono tue.\\nLa pergamena di questa settimana brucia solo mentre passano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠時間も、仕事の時間も除いて\n本当に自分だけのための時間を選んでください。\nその時間が過ぎるときだけ、今週の羊皮紙が燃えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten søvn, uten jobb,\\nvelg bare timene som er dine.\\nPergamentet denne uken brenner bare mens de går."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder slaap, zonder werk,\\nkies alleen de uren die van jou zijn.\\nHet perkament van deze week brandt alleen terwijl die verstrijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez snu, bez pracy,\\nwybierz tylko godziny, które są Twoje.\\nPergamin tego tygodnia pali się tylko wtedy, gdy one upływają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem o sono, sem o trabalho,\\nescolha só as horas que são suas.\\nO pergaminho desta semana queima só enquanto elas passam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не включайте сон,\\nне включайте работу —\\nвыберите только свои часы.\\nПергамент этой недели горит, только пока они идут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan sömn, utan arbete,\\nvälj bara de timmar som är dina.\\nVeckans pergament brinner bara medan de går."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่นับการนอน ไม่นับงาน\\nเลือกเฉพาะชั่วโมงที่เป็นของคุณ\\nกระดาษหนังของสัปดาห์นี้จะไหม้เฉพาะตอนที่เวลานั้นผ่านไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uykusuz, işsiz,\\nsadece sana ait saatleri seç.\\nBu haftanın parşömeni yalnızca onlar geçerken yanar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tính giấc ngủ, không tính công việc,\\nchỉ chọn những giờ của riêng bạn.\\nGiấy da của tuần này chỉ cháy khi chúng trôi qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不算睡觉，不算工作，\n只选真正属于你自己的时间。\n只有这段时间流逝时，本周的羊皮纸才会燃烧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不算睡覺，不算工作，\n只選真正屬於你自己的時間。\n只有這段時間流逝時，本週的羊皮紙才會燃燒。"
          }
        }
      }
    },
