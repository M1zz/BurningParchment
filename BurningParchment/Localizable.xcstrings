          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – Zeit, die noch in keiner Urne gelandet ist."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 还没有放进任何灰罐的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
