        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάψτε σε χάντζι του φεγγαριού, σελαντόν ή δειλινό, ως φωτιά στο λιβάδι, κάρβουνα ή σπίθες"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
