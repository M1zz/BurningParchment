    "글자 크기를 아주 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: layouts for larger text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly instead of getting cut off."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 아주 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字をいちばん大きくしても、切れずにきれいに並び直します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly instead of getting cut off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso con los tamaños de texto más grandes, las pantallas se reorganizan con orden en lugar de quedar cortadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei der größten Schriftgröße ordnen sich die Bildschirme sauber neu an, statt abgeschnitten zu werden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使把字号调到最大，界面也会重新排版，不会被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使把字級調到最大，介面也會重新排版，不會被截斷。"
          }
        }
      }
    },
