    "회고 %lld개. 마음먹은 대로 했어 %lld퍼센트, 어쩌다 하게 됐어 %lld퍼센트, 하려 했는데 못 했어 %lld퍼센트, 그냥 흘러갔어 %lld퍼센트" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohlédnutí: %1$lld. Udělal(a) jsem, co jsem chtěl(a): %2$lld procent; nakonec jsem to udělal(a): %3$lld procent; chtěl(a) jsem, ale nepovedlo se: %4$lld procent; prostě to uteklo: %5$lld procent"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleksioner: %1$lld. Gjorde, som jeg havde tænkt: %2$lld procent; endte med at gøre det: %3$lld procent; ville, men gjorde ikke: %4$lld procent; gled bare væk: %5$lld procent"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückblicke: %lld. Wie geplant geschafft %lld Prozent, einfach getan %lld Prozent, gewollt, aber nicht getan %lld Prozent, einfach verflogen %lld Prozent"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απολογισμοί: %1$lld. Έκανα όπως σκόπευα %2$lld τοις εκατό, κατέληξα να το κάνω %3$lld τοις εκατό, ήθελα αλλά δεν το έκανα %4$lld τοις εκατό, απλώς χάθηκε %5$lld τοις εκατό"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflections: %lld. Did what I intended %lld percent, ended up doing it %lld percent, tried but didn't %lld percent, just slipped away %lld percent"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflections: %lld. Did what I intended %lld percent, ended up doing it %lld percent, tried but didn't %lld percent, just slipped away %lld percent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexiones: %lld. Hice lo que quería: %lld por ciento. Terminé haciéndolo: %lld por ciento. Lo intenté, pero no: %lld por ciento. Simplemente se fue: %lld por ciento"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohdintoja: %1$lld. Tein niin kuin aioin %2$lld prosenttia, päädyin tekemään %3$lld prosenttia, aioin mutta jäi tekemättä %4$lld prosenttia, vain valui ohi %5$lld prosenttia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilans : %1$lld. J’ai fait ce que j’avais prévu : %2$lld pour cent ; fait sans l’avoir prévu : %3$lld pour cent ; voulu mais pas fait : %4$lld pour cent ; juste envolé : %5$lld pour cent"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleksi: %1$lld. Melakukan sesuai rencana %2$lld persen, akhirnya melakukannya %3$lld persen, ingin melakukan tetapi tidak %4$lld persen, berlalu begitu saja %5$lld persen"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riflessioni: %1$lld. Ho fatto come volevo: %2$lld per cento; fatto per caso: %3$lld per cento; volevo ma non l’ho fatto: %4$lld per cento; solo scivolato via: %5$lld per cento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふりかえり %lld件。思いどおりにできた %lld％、たまたまできた %lld％、やろうとしたけどできなかった %lld％、なんとなく過ぎた %lld％"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회고 %lld개. 마음먹은 대로 했어 %lld퍼센트, 어쩌다 하게 됐어 %lld퍼센트, 하려 했는데 못 했어 %lld퍼센트, 그냥 흘러갔어 %lld퍼센트"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleksjoner: %1$lld. Gjorde som jeg hadde tenkt: %2$lld prosent; endte opp med å gjøre det: %3$lld prosent; ville, men gjorde ikke: %4$lld prosent; rant bare bort: %5$lld prosent"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflecties: %1$lld. Deed wat ik van plan was: %2$lld procent; heb het uiteindelijk gedaan: %3$lld procent; wilde het maar deed het niet: %4$lld procent; gewoon voorbijgeglipt: %5$lld procent"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleksje: %1$lld. Zrobiłem/am, co planowałem/am: %2$lld procent; skończyło się na tym, że to zrobiłem/am: %3$lld procent; chciałem/am, ale nie zrobiłem/am: %4$lld procent; po prostu uciekło: %5$lld procent"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflexões: %1$lld. Fiz como pretendia: %2$lld por cento; acabei fazendo: %3$lld por cento; tentei, mas não fiz: %4$lld por cento; simplesmente escorreu: %5$lld por cento"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей: %1$lld. Сделал(а), как задумал(а): %2$lld процентов; так получилось: %3$lld процентов; хотел(а), но не сделал(а): %4$lld процентов; просто утекло: %5$lld процентов"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflektioner: %1$lld. Gjorde som jag tänkt: %2$lld procent; det blev så att jag gjorde det: %3$lld procent; tänkte men gjorde inte: %4$lld procent; rann bara iväg: %5$lld procent"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกทบทวน %1$lld รายการ ทำได้ตามตั้งใจ %2$lld เปอร์เซ็นต์ บังเอิญได้ทำ %3$lld เปอร์เซ็นต์ ตั้งใจแต่ไม่ได้ทำ %4$lld เปอร์เซ็นต์ ผ่านไปเฉย ๆ %5$lld เปอร์เซ็นต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerlendirme: %1$lld. Niyet ettiğim gibi yaptım yüzde %2$lld, sonunda yaptım yüzde %3$lld, yapmak istedim ama yapamadım yüzde %4$lld, sadece akıp gitti yüzde %5$lld"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản nhìn lại: %1$lld. Làm đúng như đã định %2$lld phần trăm, tình cờ làm %3$lld phần trăm, định làm nhưng không làm %4$lld phần trăm, cứ thế trôi đi %5$lld phần trăm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %lld 条回顾。按心意做了百分之 %lld，不知不觉做了百分之 %lld，本想做却没做成百分之 %lld，就这么过去了百分之 %lld"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %lld 條回顧。按心意做了百分之 %lld，不知不覺做了百分之 %lld，本想做卻沒做成百分之 %lld，就這麼過去了百分之 %lld"
          }
        }
      }
    },
