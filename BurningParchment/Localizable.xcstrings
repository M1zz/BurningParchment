          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa rajattomat uurnat ja määräajat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquez des urnes et des échéances illimitées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
