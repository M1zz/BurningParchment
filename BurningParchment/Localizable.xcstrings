          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการยกเลิกการเชื่อมต่อ ไปที่ การตั้งค่า iOS ▸ สุขภาพ ▸ การเข้าถึงข้อมูลและอุปกรณ์"
