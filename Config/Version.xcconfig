// 불타는내인생 — 버전·빌드번호의 단일 소스
//
// 이 파일이 앱(BurningParchment)과 위젯 확장(BurningParchmentWidgets)
// 두 타겟의 버전을 함께 정한다. 프로젝트 레벨 baseConfiguration 으로 연결돼 있어
// 두 타겟이 항상 같은 값을 쓴다. App Store 는 앱과 확장의 버전이 어긋나면
// 업로드를 거부하므로 반드시 한 곳에서만 고칠 것.
//
// ⚠️ Xcode 의 타겟 > General > Version·Build 칸을 고치면 project.pbxproj 에
//    MARKETING_VERSION 이 되살아나고 그쪽이 이 파일을 이겨 버린다.
//    (scripts/predeploy.sh 가 그 상황을 검사해서 배포를 막는다)
//    버전은 이 파일에서만, 또는 DeployBar 로 올린다.
//
// ⚠️ 이 프로젝트는 XcodeGen 으로 .xcodeproj 를 만든다(project.yml).
//    이 파일은 project.yml 의 configFiles 로 연결돼 있으므로
//    `xcodegen generate` 를 다시 돌려도 연결이 유지된다.

// 스토어에 표시되는 버전 (예: 1.0.9)
MARKETING_VERSION = 1.0.9

// 빌드 번호 — 같은 MARKETING_VERSION 안에서 업로드할 때마다 올린다
CURRENT_PROJECT_VERSION = 1
